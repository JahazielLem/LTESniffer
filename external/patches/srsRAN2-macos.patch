+++ b/lib/src/common/threads.c
@@ -28,6 +28,27 @@
 
 #include "srsran/common/threads.h"
 
+#ifdef __APPLE__
+// macOS provides no CPU-affinity API (cpu_set_t / CPU_* / *_affinity_np).
+// Provide no-op shims so the real-time thread helpers still build; thread
+// affinity is simply not applied on macOS.
+typedef int cpu_set_t;
+#define CPU_ZERO(set)        do { (void)(set); } while (0)
+#define CPU_SET(cpu, set)    do { (void)(cpu); (void)(set); } while (0)
+#define CPU_ISSET(cpu, set)  (0)
+#define CPU_SETSIZE          0
+static inline int pthread_attr_setaffinity_np(pthread_attr_t* a, size_t sz, const cpu_set_t* c)
+{
+  (void)a; (void)sz; (void)c;
+  return 0;
+}
+static inline int pthread_getaffinity_np(pthread_t t, size_t sz, cpu_set_t* c)
+{
+  (void)t; (void)sz; (void)c;
+  return 0;
+}
+#endif // __APPLE__
+
 bool threads_new_rt(pthread_t* thread, void* (*start_routine)(void*), void* arg)
 {
   return threads_new_rt_prio(thread, start_routine, arg, -1);
